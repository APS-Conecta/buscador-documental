# Corpus generator image for `make eval-ocr` only: the S0 generator needs the Spanish word list, numpy and fonts.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends wspanish fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir numpy==2.5.4 pillow==13.0.0 reportlab==5.0.1
