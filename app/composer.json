{
    "name": "aps-conecta/buscador-documental",
    "description": "Full-text search and OCR for the APS Conecta Nextcloud suite",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "nextcloud/ocp": "^34.0",
        "phpunit/phpunit": "^10.0",
        "doctrine/dbal": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\BuscadorDocumental\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\BuscadorDocumental\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
